{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "intercargo/hero-email-form",
  "title": "Hero Form",
  "category": "intercargo-sections",
  "icon": "email",
  "parent": [
    "intercargo/hero"
  ],
  "textdomain": "intercargo-vite",
  "attributes": {
    "shortcode": {
      "type": "string",
      "default": ""
    },
    "provider": {
      "type": "string",
      "default": ""
    },
    "formId": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "intercargo-form-editor",
  "render": "file:./render.php",
  "supports": {
    "html": false,
    "inserter": false,
    "reusable": false
  },
  "style": "intercargo-form-adapter",
  "editorStyle": "intercargo-form-editor-preview"
}
