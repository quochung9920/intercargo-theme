{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "intercargo/statement",
  "title": "Statement Band",
  "description": "Statement band with direct on-canvas text and image editing. Layout is locked by the Intercargo design system.",
  "category": "intercargo-sections",
  "icon": "format-quote",
  "keywords": [
    "intercargo",
    "section",
    "statement"
  ],
  "textdomain": "intercargo-vite",
  "intercargo": {
    "sectionPackage": true,
    "syncable": true,
    "legacyNames": [
      "acf/intercargo-statement"
    ],
    "defaultAnchor": "statement"
  },
  "attributes": {
    "data": {
      "type": "object"
    },
    "mode": {
      "type": "string"
    },
    "lineOne": {
      "type": "string"
    },
    "lineTwo": {
      "type": "string"
    },
    "lineThree": {
      "type": "string"
    },
    "bandImageId": {
      "type": "number"
    },
    "bandImageUrl": {
      "type": "string"
    },
    "sectionAnchor": {
      "type": "string"
    },
    "backgroundImageId": {
      "type": "number"
    },
    "backgroundImageUrl": {
      "type": "string"
    }
  },
  "editorScript": "file:./editor.js",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "render": "file:./render.php",
  "supports": {
    "align": false,
    "anchor": false,
    "className": false,
    "customClassName": false,
    "color": false,
    "spacing": false,
    "typography": false,
    "html": false,
    "multiple": true,
    "reusable": true
  },
  "example": {
    "attributes": {}
  }
}
