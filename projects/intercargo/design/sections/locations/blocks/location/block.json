{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "intercargo/location",
  "title": "Location",
  "description": "One facility: city, address, the port it serves, and an enquiry link.",
  "category": "intercargo-section-items",
  "icon": "building",
  "textdomain": "intercargo-vite",
  "editorScript": "intercargo-package-editor",
  "editorStyle": "intercargo-editor",
  "supports": {
    "align": false,
    "anchor": false,
    "className": false,
    "customClassName": false,
    "color": false,
    "spacing": false,
    "typography": false,
    "html": false,
    "reusable": false,
    "inserter": true
  },
  "render": "file:./render.php",
  "intercargo": {
    "packageType": "item",
    "compositionSlug": "location"
  },
  "ancestor": [
    "intercargo/locations"
  ]
}
