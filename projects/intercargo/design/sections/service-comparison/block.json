{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "intercargo/service-comparison",
  "title": "Service Comparison",
  "description": "Reusable service section combining a heading, introduction, accessible Comparison Table and supporting note.",
  "category": "intercargo-sections",
  "icon": "editor-table",
  "keywords": ["intercargo", "comparison", "table", "matrix", "options", "services"],
  "textdomain": "intercargo-vite",
  "editorScript": "intercargo-package-editor",
  "style": "file:./style.css",
  "editorStyle": "intercargo-editor",
  "supports": {
    "align": false,
    "anchor": false,
    "className": false,
    "customClassName": false,
    "color": false,
    "spacing": false,
    "typography": false,
    "html": false,
    "multiple": true,
    "reusable": true
  },
  "render": "file:./render.php",
  "intercargo": {
    "packageType": "section",
    "compositionSlug": "service-comparison",
    "sectionPackage": true,
    "syncable": true,
    "defaultAnchor": "compare"
  }
}
