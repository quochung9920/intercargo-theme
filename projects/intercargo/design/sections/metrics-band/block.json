{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "intercargo/metrics-band",
  "title": "Metrics Band",
  "description": "Reusable dark band with repeatable value-and-label metrics.",
  "category": "intercargo-sections",
  "icon": "chart-bar",
  "keywords": ["intercargo", "section", "metrics", "stats", "numbers"],
  "textdomain": "intercargo-vite",
  "editorScript": "intercargo-package-editor",
  "style": "file:./style.css",
  "editorStyle": "intercargo-editor",
  "render": "file:./render.php",
  "supports": {
    "align": false,
    "anchor": false,
    "className": false,
    "customClassName": false,
    "color": false,
    "spacing": false,
    "typography": false,
    "html": false,
    "multiple": true,
    "reusable": true
  },
  "intercargo": {
    "packageType": "section",
    "compositionSlug": "metrics-band",
    "sectionPackage": true,
    "syncable": true,
    "defaultAnchor": "by-the-numbers"
  }
}
