{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "intercargo/media-split",
  "title": "Media Split",
  "description": "Reusable image-and-copy section for service, location and supporting content pages.",
  "category": "intercargo-sections",
  "icon": "align-pull-left",
  "keywords": ["intercargo", "media", "image", "split", "content"],
  "textdomain": "intercargo-vite",
  "editorScript": "intercargo-package-editor",
  "style": "file:./style.css",
  "editorStyle": "intercargo-editor",
  "supports": {
    "align": false,
    "anchor": false,
    "className": false,
    "customClassName": false,
    "color": false,
    "spacing": false,
    "typography": false,
    "html": false,
    "multiple": true,
    "reusable": true
  },
  "render": "file:./render.php",
  "intercargo": {
    "packageType": "section",
    "compositionSlug": "media-split",
    "sectionPackage": true,
    "syncable": true,
    "defaultAnchor": "terminal"
  }
}
