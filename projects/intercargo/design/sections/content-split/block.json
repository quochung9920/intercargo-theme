{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "intercargo/content-split",
  "title": "Content Split",
  "description": "Reusable editorial section with a statement column, supporting copy and an optional bordered note.",
  "category": "intercargo-sections",
  "icon": "columns",
  "keywords": ["intercargo", "section", "content", "split", "statement", "note"],
  "textdomain": "intercargo-vite",
  "editorScript": "intercargo-package-editor",
  "style": "file:./style.css",
  "editorStyle": "intercargo-editor",
  "supports": {
    "align": false,
    "anchor": false,
    "className": false,
    "customClassName": false,
    "color": false,
    "spacing": false,
    "typography": false,
    "html": false,
    "multiple": true,
    "reusable": true
  },
  "render": "file:./render.php",
  "intercargo": {
    "packageType": "section",
    "compositionSlug": "content-split",
    "sectionPackage": true,
    "syncable": true,
    "defaultAnchor": "who-we-are"
  }
}
