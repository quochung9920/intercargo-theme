{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "intercargo/service-options",
  "title": "Service Options",
  "description": "Reusable service-choice panel with repeatable linked options and an optional condition for each option.",
  "category": "intercargo-sections",
  "icon": "list-view",
  "keywords": ["intercargo", "service", "options", "choices"],
  "textdomain": "intercargo-vite",
  "editorScript": "intercargo-package-editor",
  "style": "file:./style.css",
  "editorStyle": "intercargo-editor",
  "supports": {
    "align": false,
    "anchor": false,
    "className": false,
    "customClassName": false,
    "color": false,
    "spacing": false,
    "typography": false,
    "html": false,
    "multiple": true,
    "reusable": true
  },
  "render": "file:./render.php",
  "intercargo": {
    "packageType": "section",
    "compositionSlug": "service-options",
    "sectionPackage": true,
    "syncable": true
  }
}
