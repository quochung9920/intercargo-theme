{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "intercargo/service-flow",
  "title": "Service Flow",
  "description": "A reusable explanatory flow with editable heading, introduction and repeatable illustrated steps.",
  "category": "intercargo-sections",
  "icon": "networking",
  "keywords": ["intercargo", "service", "flow", "steps", "diagram"],
  "textdomain": "intercargo-vite",
  "editorScript": "intercargo-package-editor",
  "style": "file:./style.css",
  "editorStyle": "intercargo-editor",
  "supports": {
    "align": false,
    "anchor": false,
    "className": false,
    "customClassName": false,
    "color": false,
    "spacing": false,
    "typography": false,
    "html": false,
    "multiple": true,
    "reusable": true
  },
  "render": "file:./render.php",
  "intercargo": {
    "packageType": "section",
    "compositionSlug": "service-flow",
    "sectionPackage": true,
    "syncable": true,
    "defaultAnchor": "service-flow"
  }
}
