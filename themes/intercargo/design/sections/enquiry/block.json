{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "intercargo/enquiry",
  "title": "Enquiry",
  "description": "Enquiry section with direct on-canvas content editing and provider-neutral form selection.",
  "category": "intercargo-sections",
  "icon": "email-alt",
  "keywords": [
    "intercargo",
    "section",
    "enquiry"
  ],
  "textdomain": "intercargo-vite",
  "intercargo": {
    "sectionPackage": true,
    "syncable": true,
    "legacyNames": [
      "acf/intercargo-enquiry"
    ],
    "defaultAnchor": "enquiry"
  },
  "attributes": {
    "data": {
      "type": "object"
    },
    "mode": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "lead": {
      "type": "string"
    },
    "steps": {
      "type": "array"
    },
    "contactNote": {
      "type": "string"
    },
    "formLabel": {
      "type": "string"
    },
    "formNote": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "formId": {
      "type": "string"
    },
    "legacyShortcode": {
      "type": "string"
    },
    "sectionAnchor": {
      "type": "string"
    },
    "backgroundImageId": {
      "type": "number"
    },
    "backgroundImageUrl": {
      "type": "string"
    }
  },
  "editorScript": "file:./editor.js",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "render": "file:./render.php",
  "supports": {
    "align": false,
    "anchor": false,
    "className": false,
    "customClassName": false,
    "color": false,
    "spacing": false,
    "typography": false,
    "html": false,
    "multiple": true,
    "reusable": true
  }
}
