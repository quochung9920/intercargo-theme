{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "intercargo/media-mosaic",
  "title": "Media Mosaic",
  "description": "Reusable asymmetric image mosaic with editable heading, introduction and repeatable captioned media tiles.",
  "category": "intercargo-sections",
  "icon": "format-gallery",
  "keywords": ["intercargo", "section", "media", "mosaic", "gallery", "operations"],
  "textdomain": "intercargo-vite",
  "editorScript": "intercargo-package-editor",
  "style": "file:./style.css",
  "editorStyle": "intercargo-editor",
  "render": "file:./render.php",
  "supports": {
    "align": false,
    "anchor": false,
    "className": false,
    "customClassName": false,
    "color": false,
    "spacing": false,
    "typography": false,
    "html": false,
    "multiple": true,
    "reusable": true
  },
  "intercargo": {
    "packageType": "section",
    "compositionSlug": "media-mosaic",
    "sectionPackage": true,
    "syncable": true,
    "defaultAnchor": "operation"
  }
}
