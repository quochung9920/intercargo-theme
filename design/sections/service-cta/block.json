{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "intercargo/service-cta",
  "title": "Service CTA Band",
  "description": "Dark service conversion band with editable headline, supporting copy and provider-neutral compact form.",
  "category": "intercargo-sections",
  "icon": "megaphone",
  "keywords": ["intercargo", "service", "cta", "conversion", "form"],
  "textdomain": "intercargo-vite",
  "editorScript": "intercargo-package-editor",
  "style": "file:./style.css",
  "editorStyle": "intercargo-editor",
  "supports": {
    "align": false,
    "anchor": false,
    "className": false,
    "customClassName": false,
    "color": false,
    "spacing": false,
    "typography": false,
    "html": false,
    "multiple": true,
    "reusable": true
  },
  "render": "file:./render.php",
  "example": {"attributes": {}},
  "intercargo": {
    "packageType": "section",
    "compositionSlug": "service-cta",
    "sectionPackage": true,
    "syncable": true,
    "serviceNavigation": false
  }
}
