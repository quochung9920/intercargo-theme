          "name": "Column title"
        }
      }
    ],
    [
      "core/paragraph",
      {
        "className": "content-column-copy",
        "placeholder": "Column description",
        "content": "Describe this point.",
        "metadata": {
          "name": "Column description"
        }
      }
    ]
  ]
}
