{
  "_comment": "One structured Content Column. It is an item, not a top-level section.",
  "item": {
    "element": "article",
    "className": "reason-card content-column",
    "parent": "intercargo/reasons"
  },
  "template": [
    [
      "core/heading",
      {
        "level": 3,
        "className": "content-column-title",
        "placeholder": "Column title",
        "content": "Column title",
